# ==============================================================================
# CivicLens AI Platform — Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=True
APP_NAME=CivicLens AI
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=civiclens-super-secret-development-key-change-in-production-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173

# Database Connection
# For local development (SQLite async):
DATABASE_URL=sqlite+aiosqlite:///./civiclens.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://civiclens_user:civiclens_password@localhost:5432/civiclens_db

# Redis & Caching (Optional fallback to in-memory)
REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_CACHE=True

# File & Image Storage
STORAGE_BACKEND=local
# Options: local, s3
LOCAL_STORAGE_PATH=./storage/uploads
LOCAL_THUMBNAILS_PATH=./storage/thumbnails
MAX_UPLOAD_SIZE_MB=15
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp,image/heic

# S3 Configuration (when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=civiclens-media
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# AI & ML Engine Configuration
AI_MODEL_DEVICE=cpu
AI_CONFIDENCE_THRESHOLD=0.65
AI_DUPLICATE_SIMILARITY_THRESHOLD=0.75
AI_DUPLICATE_GEO_RADIUS_METERS=150
AI_SEVERITY_MODEL_PATH=./ai/weights/severity_model.json
AI_CLASSIFIER_MODEL_PATH=./ai/weights/issue_classifier.json

# Priority Engine Weights (Sums to 1.0)
PRIORITY_WEIGHT_SEVERITY=0.35
PRIORITY_WEIGHT_SAFETY_RISK=0.25
PRIORITY_WEIGHT_TRAFFIC_IMPACT=0.15
PRIORITY_WEIGHT_DUPLICATES=0.15
PRIORITY_WEIGHT_PERSISTENCE=0.10

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=
FIREBASE_CREDENTIALS_PATH=

# Authority Email Integration Fallback
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@civiclens.local
SMTP_TLS=True

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
COMPLAINT_SUBMISSION_LIMIT_PER_HOUR=10
